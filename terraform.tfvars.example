# ROSA HCP Cluster Configuration
# Copy this file to terraform.tfvars and adjust values as needed

# AWS Region
region = "ap-northeast-1"

# Cluster name (max 15 characters)
cluster_name = "rosa-hcp"

# OpenShift version
openshift_version = "4.20.25"

# Number of default worker nodes
replicas = 2

# EC2 instance type for default worker nodes
# See: https://docs.aws.amazon.com/ec2/latest/instancetypes/
compute_machine_type = "m5.2xlarge"

# VPC CIDR block
vpc_cidr = "10.0.0.0/16"

# Availability zones
availability_zones = ["ap-northeast-1a", "ap-northeast-1c"]

# Cluster-level AZs (immutable after creation)
cluster_availability_zones = ["ap-northeast-1a"]

# AWS billing account linked to your Red Hat org in AWS Marketplace.
# Leave unset (null) to auto-detect.
aws_billing_account_id = "123456789012"
